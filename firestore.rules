rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each reader reads and writes only their own progress and commentary (account.js); nothing else is open
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // the reader's commentary, one document per verse, of at most 20,000 letters
      match /notes/{verse} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
                              && request.resource.data.text is string
                              && request.resource.data.text.size() <= 20000;
      }
    }
  }
}
